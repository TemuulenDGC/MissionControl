:root {
    --border-color: #1a1a1a;
    --header-bg: #0a0a0a;
    --accent: #00ff41;
}

body, html {
    margin: 0; padding: 0;
    height: 100vh; width: 100vw;
    background: #000;
    font-family: 'Courier New', monospace;
    overflow: hidden;
}

.master-grid {
    display: grid;
    grid-template-columns: 40% 60%; /* Adjust width of Avalon here */
    height: 100vh;
    gap: 10px;
    padding: 10px;
    box-sizing: border-box;
}

.right-stack {
    display: grid;
    grid-template-rows: 50% 50%;
    gap: 10px;
}

.panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    background: #000;
    position: relative;
}

.panel:hover {
    border-color: var(--accent);
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.1);
}

.panel-header {
    background: var(--header-bg);
    color: #444;
    font-size: 10px;
    padding: 5px 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 1px solid var(--border-color);
}

.panel:hover .panel-header {
    color: var(--accent);
}

iframe {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
}

/* Scrollbar styling for the master window */
::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-thumb { background: #222; }
